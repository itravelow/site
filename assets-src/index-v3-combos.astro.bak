---
import { BRAND, TAGLINE, EMAIL, SERVICES, FAQ, PAYMENTS, COMBOS, COMBO_DISCOUNTS, waLink } from '../config';
function priceFor(serviceSlug: string, optionId: string, pax: number, rt: boolean): number {
  const s = SERVICES.find((x) => x.slug === serviceSlug)!;
  const o = s.options.find((x) => x.id === optionId) || s.options[0];
  const units = o.unit === 'vehículo' ? Math.ceil(pax / (o.capacity || 4)) : pax;
  return o.price * units * (s.roundTrip && rt ? 2 : 1);
}
const comboCards = COMBOS.map((c) => {
  const d = COMBO_DISCOUNTS[c.items.length] || 0;
  const full = c.items.reduce((acc, i) => acc + priceFor(i.service, i.option, 2, Boolean(i.roundTrip)), 0);
  return {
    ...c, pct: Math.round(d * 100), full, price: Math.round(full * (1 - d)),
    lines: c.items.map((i) => {
      const sv = SERVICES.find((x) => x.slug === i.service)!; const op = sv.options.find((x) => x.id === i.option)!;
      return `${sv.name}: ${op.label}${i.roundTrip ? ', ida y vuelta' : ''}`;
    }),
  };
});
const year = new Date().getFullYear();
const supportLink = waLink('Hola, tengo una pregunta sobre una reserva en iTravelow.');
const ld = [
  {
    '@context': 'https://schema.org', '@type': 'TravelAgency', name: BRAND, url: 'https://itravelow.com',
    image: 'https://itravelow.com/og.jpg', description: TAGLINE, email: EMAIL,
    areaServed: { '@type': 'Place', name: 'Punta Cana, República Dominicana' },
    availableLanguage: ['es', 'en'], priceRange: '$35 - $140',
    makesOffer: SERVICES.map((s) => ({ '@type': 'Offer', name: s.name, price: s.from, priceCurrency: 'USD' })),
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
// Datos mínimos para calcular el total en el navegador (sin costos de operador).
const catalog = SERVICES.map((s) => ({ slug: s.slug, name: s.name, options: s.options, roundTrip: Boolean(s.roundTrip), minPax: s.minPax, maxPax: s.maxPax }));
const phones = [
  { pos: 'left', img: '/media/phone-saona.webp', alt: 'Piscina natural de Isla Saona con un catamarán anclado', video: '' },
  { pos: 'center', img: '/media/phone-avion.webp', alt: 'Vista desde la ventana del avión al descender sobre la costa de Punta Cana', video: '/media/phone-avion' },
  { pos: 'right', img: '/media/phone-buggy.webp', alt: 'Camino de tierra roja entre cañaverales cerca de Macao', video: '' },
];
const pending = PAYMENTS.provider === 'pending';
const combos = COMBOS;
const discounts = COMBO_DISCOUNTS;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{BRAND} · Traslados y excursiones en Punta Cana, reserva y paga en línea</title>
  <meta name="description" content="Traslado aeropuerto-hotel, buggies, Isla Saona y Coco Bongo en Punta Cana. Precio cerrado, reserva y pago en línea, confirmación por escrito y asistencia en español 24/7." />
  <link rel="canonical" href="https://itravelow.com/" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500..800&display=swap" />
  <link rel="preload" as="image" href="/media/phone-avion.webp" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={`${BRAND} · Punta Cana, reservado antes de aterrizar`} />
  <meta property="og:description" content={TAGLINE} />
  <meta property="og:image" content="https://itravelow.com/og.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="es_ES" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#2e18a3" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style is:global>
    :root {
      --indigo: #2e18a3;
      --indigo-deep: #1c0e6b;
      --indigo-soft: #ecebfa;
      --magenta: #e8087f;
      --magenta-ink: #c2066a;
      --magenta-hover: #d4076f;
      --ink: #14103a;
      --muted: #5b5878;
      --line: #e3e1ee;
      --surface: #f6f5fc;
      --bg: #ffffff;
      --display: "Bricolage Grotesque", ui-sans-serif, system-ui, sans-serif;
      --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
      --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
      --ease-drawer: cubic-bezier(0.32, 0.72, 0, 1);
    }
    * { box-sizing: border-box; }
    [hidden] { display: none !important; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0; color: var(--ink); background: var(--bg);
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      font-size: 17px; line-height: 1.55;
    }
    a { color: var(--indigo); }
    :focus-visible { outline: 3px solid var(--magenta); outline-offset: 3px; }
    img, video { max-width: 100%; height: auto; display: block; }
    h1, h2, h3 { font-family: var(--display); font-variation-settings: "wdth" 88, "opsz" 48; letter-spacing: -0.015em; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 20px; }
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px; padding: 14px 24px; border-radius: 999px;
      font-weight: 700; text-decoration: none; border: 2px solid transparent; font-size: 16px; line-height: 1.3; font-family: var(--display);
      cursor: pointer; transition: transform 160ms var(--ease-out), background-color 160ms ease, color 160ms ease, border-color 160ms ease;
    }
    .btn:active { transform: scale(0.97); }
    .btn-primary { background: var(--magenta-ink); color: #fff; }
    .btn-primary:hover { background: var(--magenta-hover); }
    .btn-ghost { border-color: var(--indigo); color: var(--indigo); background: transparent; }
    .btn-ghost:hover { background: var(--indigo-soft); }
    .btn-sm { padding: 10px 18px; font-size: 15px; }

    header { position: sticky; top: 0; z-index: 20; background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 12px 0; }
    .nav img { height: 38px; width: auto; }
    .nav nav { display: none; gap: 26px; font-size: 15.5px; }
    .nav nav a { color: var(--ink); text-decoration: none; padding: 4px 0; border-bottom: 2px solid transparent; transition: border-color 160ms ease; }
    .nav nav a:hover { border-bottom-color: var(--magenta); }

    /* Hero: el corte diagonal viene de la "l" del logo */
    .hero { position: relative; overflow: hidden; background: var(--bg); }
    .hero::before { content: ""; position: absolute; inset: 0; background: var(--indigo); clip-path: polygon(0 64%, 100% 53%, 100% 100%, 0 100%); z-index: 0; }
    .hero::after { content: ""; position: absolute; inset: 0; background: var(--magenta); clip-path: polygon(0 64%, 100% 53%, 100% 54.4%, 0 65.4%); z-index: 0; }
    .hero .wrap { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr; gap: 8px; padding-top: 40px; padding-bottom: 0; }
    .hero h1 { font-size: clamp(40px, 7vw, 72px); line-height: 0.98; margin: 0 0 18px; font-weight: 800; color: var(--indigo-deep); max-width: 12ch; }
    .hero .lead { font-size: 19px; margin: 0 0 26px; max-width: 46ch; }
    .hero .cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 14px; }
    .hero .note { font-size: 15px; color: var(--muted); margin: 0 0 12px; max-width: 46ch; }

    .stage { position: relative; height: 440px; perspective: 1400px; }
    .group { position: absolute; inset: 0; display: grid; place-items: center; transform-style: preserve-3d; transition: transform 500ms var(--ease-out); }
    .phone {
      position: absolute; margin: 0; width: clamp(150px, 42vw, 210px); aspect-ratio: 9 / 19;
      background: #0d0b1e; border-radius: 34px; padding: 9px;
      box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255,255,255,0.08) inset;
      transform: var(--base); opacity: 0; animation: enter 900ms var(--ease-out) both, float 7s ease-in-out 900ms infinite alternate;
    }
    .phone.left { --base: translateX(-64%) translateZ(-60px) rotateY(36deg) scale(0.9); animation-delay: 120ms, 1020ms; }
    .phone.center { --base: translateZ(30px); animation-delay: 0ms, 900ms; z-index: 2; }
    .phone.right { --base: translateX(64%) translateZ(-60px) rotateY(-36deg) scale(0.9); animation-delay: 240ms, 1140ms; }
    .phone::before { content: ""; position: absolute; top: 16px; left: 50%; width: 34%; height: 18px; background: #0d0b1e; border-radius: 999px; transform: translateX(-50%); z-index: 3; }
    .screen { position: relative; width: 100%; height: 100%; border-radius: 26px; overflow: hidden; background: var(--indigo-deep); }
    .screen img, .screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .screen video { opacity: 0; transition: opacity 400ms ease; }
    .screen video.on { opacity: 1; }
    @keyframes enter { from { opacity: 0; transform: var(--base) translateY(40px); } to { opacity: 1; transform: var(--base) translateY(0); } }
    @keyframes float { from { transform: var(--base) translateY(0); } to { transform: var(--base) translateY(-10px); } }

    section { padding: 64px 0; }
    section.surface { background: var(--surface); }
    h2 { font-size: clamp(30px, 4.2vw, 44px); margin: 0 0 8px; font-weight: 800; color: var(--indigo-deep); line-height: 1.06; }
    .sub { color: var(--muted); margin: 0 0 30px; max-width: 60ch; }

    .board { border-top: 3px solid var(--indigo); }
    .row { display: grid; gap: 16px 24px; grid-template-columns: 1fr; padding: 26px 0; border-bottom: 1px solid var(--line); align-items: start; }
    .row img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 8px; }
    .row h3 { margin: 0 0 4px; font-size: 25px; font-weight: 700; }
    .row .time { color: var(--muted); font-size: 15px; margin: 0 0 10px; }
    .row ul { margin: 0; padding-left: 18px; }
    .row ul li { margin: 3px 0; }
    .row ul.no { color: var(--muted); font-size: 15.5px; margin-top: 6px; }
    .row .buy { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
    .price { font-family: var(--display); font-weight: 800; font-size: 36px; line-height: 1; color: var(--magenta-ink); margin: 0; }
    .price small { display: block; font-weight: 600; font-size: 14px; color: var(--muted); margin-top: 6px; }
    .price .desde { font-size: 15px; font-weight: 600; color: var(--indigo); display: block; margin-bottom: 4px; }

    .board.combos .row { grid-template-columns: 1fr; }
    .board.combos h3 { font-size: 23px; }
    .board.combos .blurb { margin: 0 0 10px; color: var(--muted); font-size: 15.5px; }
    .crumb { color: var(--muted); font-size: 14px; margin: 0 0 10px; }
    .cart { list-style: none; margin: 0 0 12px; padding: 0; }
    .cart li { display: grid; grid-template-columns: 1fr auto; gap: 2px 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
    .cart li b { font-family: var(--display); }
    .cart li .meta { color: var(--muted); grid-column: 1; }
    .cart li .ops { grid-column: 1 / -1; display: flex; gap: 14px; }
    .cart li .ops button { border: 0; background: none; color: var(--indigo); cursor: pointer; padding: 0; font: 700 14px var(--display); }
    .addmore { background: var(--surface); border-radius: 12px; padding: 12px 14px; margin-bottom: 10px; font-size: 15px; }
    .addmore strong { display: block; margin-bottom: 8px; font-family: var(--display); }
    .addmore .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { border: 1.5px solid var(--indigo); color: var(--indigo); background: #fff; border-radius: 999px; padding: 6px 12px; font: 700 14px var(--display); cursor: pointer; transition: background-color 160ms ease, transform 160ms var(--ease-out); }
    .chip:hover { background: var(--indigo-soft); }
    .chip:active { transform: scale(0.97); }
    .total .off { color: var(--magenta-ink); font-weight: 700; }
    .reveal { opacity: 0; transform: translateY(14px); transition: opacity 500ms var(--ease-out), transform 500ms var(--ease-out); }
    .reveal[data-visible] { opacity: 1; transform: none; }
    .reveal:nth-child(2) { transition-delay: 60ms; }
    .reveal:nth-child(3) { transition-delay: 120ms; }
    .reveal:nth-child(4) { transition-delay: 180ms; }

    .how { display: grid; gap: 36px; grid-template-columns: 1fr; align-items: start; }
    .steps { list-style: none; margin: 0; padding: 0; }
    .steps li { position: relative; padding: 0 0 26px 38px; }
    .steps li::before { content: ""; position: absolute; left: 9px; top: 10px; width: 2px; height: calc(100% - 4px); background: var(--line); }
    .steps li:last-child::before { display: none; }
    .steps li::after { content: ""; position: absolute; left: 3px; top: 7px; width: 14px; height: 14px; border-radius: 50%; background: var(--magenta); box-shadow: 0 0 0 4px #fff; }
    .steps strong { display: block; font-family: var(--display); font-size: 21px; font-weight: 700; margin-bottom: 4px; }
    .steps p { margin: 0; color: var(--muted); }
    .confirm { background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 18px 18px 14px; max-width: 440px; width: 100%; margin: 0 auto; box-shadow: 0 20px 50px -30px rgba(0,0,0,0.25); }
    .confirm .head { display: flex; align-items: center; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid var(--line); margin-bottom: 12px; }
    .confirm .head img { width: 28px; height: 28px; border-radius: 50%; }
    .confirm .head strong { display: block; font-size: 15px; }
    .confirm .head span { font-size: 13px; color: var(--muted); }
    .confirm .ok { display: inline-block; background: var(--indigo-soft); color: var(--indigo-deep); border-radius: 999px; padding: 4px 12px; font-weight: 700; font-size: 14px; margin-bottom: 10px; }
    .confirm dl { margin: 0; display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; font-size: 15px; }
    .confirm dt { color: var(--muted); }
    .confirm dd { margin: 0; font-weight: 600; }
    .confirm .foot { font-size: 13px; color: var(--muted); margin: 12px 0 0; }
    .confirm .line { opacity: 0; transform: translateY(6px); transition: opacity 400ms var(--ease-out), transform 400ms var(--ease-out); }
    .confirm[data-visible] .line { opacity: 1; transform: none; }
    .confirm[data-visible] dl .line:nth-child(3), .confirm[data-visible] dl .line:nth-child(4) { transition-delay: 90ms; }
    .confirm[data-visible] dl .line:nth-child(5), .confirm[data-visible] dl .line:nth-child(6) { transition-delay: 180ms; }
    .confirm[data-visible] dl .line:nth-child(7), .confirm[data-visible] dl .line:nth-child(8) { transition-delay: 270ms; }
    .confirm[data-visible] .foot { transition-delay: 360ms; }

    .trustband { background: var(--indigo-deep); color: #fff; }
    .trustband h2 { color: #fff; }
    .trustband .sub { color: #cfc8ff; }
    .trust { display: grid; gap: 22px 36px; grid-template-columns: 1fr; }
    .trust div { padding: 16px 0 0; border-top: 1px solid rgba(255,255,255,0.22); }
    .trust strong { display: block; font-family: var(--display); font-size: 20px; font-weight: 700; margin-bottom: 4px; }
    .trust span { color: #d9d4ff; font-size: 15.5px; }

    .who { display: grid; gap: 20px; grid-template-columns: 1fr; align-items: start; }
    .who .ph { width: 120px; height: 120px; border-radius: 50%; background: var(--surface); border: 1px solid var(--line); display: grid; place-items: center; color: var(--muted); font-size: 13px; text-align: center; }
    .who p { margin: 0 0 12px; }

    details { border-top: 1px solid var(--line); padding: 14px 0; }
    details:last-of-type { border-bottom: 1px solid var(--line); }
    summary { cursor: pointer; font-weight: 700; font-size: 17px; list-style: none; display: flex; justify-content: space-between; gap: 12px; font-family: var(--display); }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: "+"; color: var(--magenta-ink); font-weight: 800; flex: none; transition: transform 200ms var(--ease-out); }
    details[open] summary::after { transform: rotate(45deg); }
    details p { margin: 10px 0 0; color: var(--muted); max-width: 70ch; }

    .contact { background: var(--indigo); color: #fff; }
    .contact h2 { color: #fff; }
    .contact p { max-width: 60ch; }
    .contact a { color: #fff; }
    footer { padding: 0 0 40px; font-size: 14px; background: var(--indigo); color: #d9d4ff; }
    footer .wrap { display: flex; flex-wrap: wrap; gap: 10px 28px; justify-content: space-between; border-top: 1px solid rgba(255,255,255,0.22); padding-top: 22px; }

    .support { position: fixed; right: 16px; bottom: 16px; z-index: 30; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
    .support .bubble {
      display: inline-flex; align-items: center; gap: 10px; background: #1b7f46; color: #fff; border: 0; border-radius: 999px; padding: 12px 18px 12px 14px;
      font: 700 15px/1.3 var(--display); cursor: pointer; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.35);
      opacity: 0; transform: translateY(12px) scale(0.96); transition: opacity 300ms var(--ease-out), transform 300ms var(--ease-out), background-color 160ms ease;
    }
    .support .bubble[data-shown] { opacity: 1; transform: none; }
    .support .bubble:hover { background: #15663a; }
    .support .bubble:active { transform: scale(0.97); }
    .support .bubble svg { width: 22px; height: 22px; }
    .support .panel {
      background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 16px; padding: 14px 16px; width: min(320px, calc(100vw - 32px));
      box-shadow: 0 20px 50px -24px rgba(0,0,0,0.35); font-size: 15px; transform-origin: bottom right;
      opacity: 0; transform: translateY(8px) scale(0.96); transition: opacity 200ms var(--ease-out), transform 200ms var(--ease-out); pointer-events: none;
    }
    .support .panel[data-open] { opacity: 1; transform: none; pointer-events: auto; }
    .support .panel strong { display: block; font-family: var(--display); font-size: 17px; margin-bottom: 4px; }
    .support .panel p { margin: 0 0 8px; }
    .support .panel a { font-weight: 700; }

    dialog.checkout { border: 0; padding: 0; margin: 0; max-width: none; max-height: none; width: 100vw; height: 100dvh; background: transparent; color: var(--ink); }
    dialog.checkout::backdrop { background: rgba(20, 16, 58, 0.5); }
    .sheet {
      position: fixed; right: 0; bottom: 0; left: 0; max-height: 92dvh; overflow: auto; background: #fff; border-radius: 22px 22px 0 0; padding: 18px 20px 28px;
      transform: translateY(0); transition: transform 500ms var(--ease-drawer);
    }
    dialog.checkout[data-closed] .sheet { transform: translateY(100%); }
    .sheet .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
    .sheet .top h3 { margin: 0; font-size: 23px; font-weight: 700; }
    .sheet .close { border: 0; background: var(--surface); width: 40px; height: 40px; border-radius: 50%; font-size: 22px; cursor: pointer; color: var(--ink); }
    .sheet .step { display: none; }
    .sheet .step[data-active] { display: block; }
    .field { display: block; margin: 0 0 14px; }
    .field > span { display: block; font-weight: 700; font-size: 15px; margin-bottom: 6px; }
    .field input { width: 100%; border: 1.5px solid var(--line); border-radius: 12px; padding: 12px 14px; font: inherit; color: var(--ink); background: #fff; }
    .field input:focus { border-color: var(--indigo); outline: none; box-shadow: 0 0 0 3px var(--indigo-soft); }
    .opts { display: grid; gap: 8px; }
    .opt { display: flex; align-items: center; gap: 12px; border: 1.5px solid var(--line); border-radius: 12px; padding: 12px 14px; cursor: pointer; transition: border-color 160ms ease, background-color 160ms ease; }
    .opt:has(input:checked) { border-color: var(--indigo); background: var(--indigo-soft); }
    .opt input { accent-color: var(--indigo); width: 18px; height: 18px; flex: none; margin: 0; }
    .opt span { flex: 1; }
    .opt b { margin-left: auto; font-family: var(--display); white-space: nowrap; }
    .stepper { display: inline-flex; align-items: center; border: 1.5px solid var(--line); border-radius: 12px; overflow: hidden; }
    .stepper button { width: 44px; height: 44px; border: 0; background: #fff; font-size: 22px; cursor: pointer; color: var(--indigo); transition: background-color 120ms ease; }
    .stepper button:hover { background: var(--indigo-soft); }
    .stepper output { min-width: 48px; text-align: center; font-weight: 700; font-variant-numeric: tabular-nums; }
    .check { display: flex; align-items: center; gap: 10px; margin: 4px 0 14px; cursor: pointer; }
    .total { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border-top: 2px solid var(--indigo); padding-top: 12px; margin: 8px 0 14px; }
    .total strong { font-family: var(--display); font-size: 30px; font-weight: 800; color: var(--magenta-ink); font-variant-numeric: tabular-nums; }
    .total small { color: var(--muted); font-size: 14px; }
    .actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .actions .btn { flex: 1; }
    .summary { background: var(--surface); border-radius: 12px; padding: 12px 14px; font-size: 15px; margin-bottom: 14px; }
    .summary div { display: flex; justify-content: space-between; gap: 12px; padding: 3px 0; }
    .summary div span:first-child { color: var(--muted); }
    .err { color: var(--magenta-ink); font-size: 14px; margin: -8px 0 12px; display: none; }
    .err[data-show] { display: block; }
    .hint { color: var(--muted); font-size: 14px; margin: 12px 0 0; }
    .done { text-align: center; padding: 10px 0; }
    .done .ok { width: 64px; height: 64px; border-radius: 50%; background: var(--indigo-soft); color: var(--indigo); display: grid; place-items: center; margin: 0 auto 14px; font-size: 30px; }
    .done h3 { margin: 0 0 8px; }
    .done p { color: var(--muted); margin: 0 0 14px; }
    .done textarea { width: 100%; min-height: 150px; border: 1.5px solid var(--line); border-radius: 12px; padding: 10px; font: 14px/1.4 ui-monospace, monospace; color: var(--ink); }
    .done .actions { margin-top: 12px; }

    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .phone { animation: fadein 600ms ease both; }
      @keyframes fadein { from { opacity: 0; } to { opacity: 1; } }
      .group { transition: none; }
      .reveal { transform: none; transition: opacity 300ms ease; }
      .confirm .line { transform: none; }
      .sheet { transition: none; }
      .support .bubble { transition: opacity 200ms ease; transform: none; }
    }

    @media (min-width: 900px) {
      .nav nav { display: flex; }
      .nav img { height: 44px; }
      .hero::before { clip-path: polygon(59% 0, 100% 0, 100% 100%, 41% 100%); }
      .hero::after { clip-path: polygon(59% 0, 60.4% 0, 42.4% 100%, 41% 100%); }
      .hero .wrap { grid-template-columns: 1.05fr 1fr; gap: 24px; padding-top: 56px; padding-bottom: 56px; align-items: center; }
      .stage { height: 560px; }
      .phone { width: 220px; }
      .row { grid-template-columns: 210px 1fr 220px; }
      .row .buy { align-items: flex-end; text-align: right; }
      .board.combos .row { grid-template-columns: 1fr 260px; }
      .how { grid-template-columns: 1fr 1fr; gap: 56px; }
      .trust { grid-template-columns: 1fr 1fr; }
      .who { grid-template-columns: 140px 1fr; }
      .sheet { left: auto; top: 0; width: 460px; max-height: 100dvh; height: 100dvh; border-radius: 0; padding: 24px 28px 32px; transform: translateX(0); }
      dialog.checkout[data-closed] .sheet { transform: translateX(100%); }
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap nav">
      <a href="/" aria-label={BRAND}><img src="/logo.webp" alt={BRAND} width="189" height="44" /></a>
      <nav aria-label="Secciones">
        <a href="#tours">Tours y precios</a>
        <a href="#combos">Combos</a>
        <a href="#como-funciona">Cómo funciona</a>
        <a href="#confianza">Confianza</a>
        <a href="#preguntas">Preguntas</a>
      </nav>
      <a class="btn btn-primary btn-sm" href="#tours">Reservar</a>
    </div>
  </header>

  <main>
    <div class="hero">
      <div class="wrap">
        <div class="copy">
          <h1>Punta Cana, reservado antes de aterrizar.</h1>
          <p class="lead">Traslado, Isla Saona, buggies y Coco Bongo con precio cerrado. Reservas y pagas aquí, te confirmamos por escrito con hora y nombre del chofer. El día del servicio, solo te subes.</p>
          <div class="cta">
            <a class="btn btn-primary" href="#tours">Ver tours y precios</a>
            <a class="btn btn-ghost" href="#como-funciona">Cómo funciona</a>
          </div>
          <p class="note">Cancelación gratis hasta 24 horas antes. Atendemos en español, con operadores locales con licencia de turismo.</p>
        </div>
        <div class="stage">
          <div class="group" data-group>
            {phones.map((p) => (
              <figure class={`phone ${p.pos}`}>
                <div class="screen" data-video={p.video}>
                  <img src={p.img} alt={p.alt} width="720" height="1280" loading={p.pos === 'center' ? 'eager' : 'lazy'} decoding="async" fetchpriority={p.pos === 'center' ? 'high' : 'auto'} />
                  {p.video && <video muted loop playsinline preload="none" aria-hidden="true"></video>}
                </div>
              </figure>
            ))}
          </div>
        </div>
      </div>
    </div>

    <section id="tours">
      <div class="wrap">
        <h2>Tours y precios</h2>
        <p class="sub">Precios en dólares, por persona o por vehículo. Eliges, ves el total y reservas. Sin "consultar precio".</p>
        <div class="board">
          {SERVICES.map((s) => (
            <article class="row reveal" id={s.slug}>
              <img src={s.image} srcset={`${s.image} 480w, ${s.image.replace("-480", "-960")} 960w`} sizes="(min-width: 900px) 210px, 100vw" width="480" height="360" alt={s.alt} loading="lazy" decoding="async" />
              <div>
                <h3>{s.name}</h3>
                <p class="time">{s.time}</p>
                <ul>{s.includes.map((i) => <li>{i}</li>)}</ul>
                <ul class="no">{s.excludes.map((i) => <li>No incluye: {i}</li>)}</ul>
              </div>
              <div class="buy">
                <p class="price"><span class="desde">desde</span>${s.from} USD<small>{s.fromUnit}</small></p>
                <button class="btn btn-primary btn-sm" type="button" data-reserve={s.slug}>Reservar</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="surface" id="combos">
      <div class="wrap">
        <h2>Combos con descuento</h2>
        <p class="sub">Dos tours en la misma reserva: 5 % menos. Tres: 8 %. Los cuatro: 10 %. También aplica si los combinas tú desde cualquier botón "Reservar".</p>
        <div class="board combos">
          {comboCards.map((c) => (
            <article class="row reveal" id={`combo-${c.slug}`}>
              <div>
                <h3>{c.name}</h3>
                <p class="blurb">{c.blurb}</p>
                <ul>{c.lines.map((l) => <li>{l}</li>)}</ul>
              </div>
              <div class="buy">
                <p class="price"><span class="desde">{c.pct} % de descuento</span>{c.price} USD<small>para 2 personas, en vez de {c.full} USD</small></p>
                <button class="btn btn-primary btn-sm" type="button" data-combo={c.slug}>Reservar combo</button>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="como-funciona">
      <div class="wrap how">
        <div>
          <h2>Cómo funciona</h2>
          <p class="sub">Tres pasos y todo queda por escrito.</p>
          <ol class="steps">
            <li class="reveal"><strong>Eliges y pagas</strong><p>Producto, fecha, personas y hotel. Ves el total antes de pagar y pagas con tarjeta en un enlace seguro.</p></li>
            <li class="reveal"><strong>Te confirmamos por escrito</strong><p>En menos de 1 hora, al WhatsApp y al correo: hora de recogida, punto de encuentro y nombre del chofer o guía.</p></li>
            <li class="reveal"><strong>El día, solo te subes</strong><p>Nada más que pagar, nada que negociar. Si algo cambia, nos escribes y lo resolvemos nosotros con el operador.</p></li>
          </ol>
        </div>
        <div class="confirm" data-confirm aria-label="Ejemplo de confirmación">
          <div class="head"><img src="/favicon.svg" alt="" width="28" height="28" /><div><strong>{BRAND}</strong><span>Confirmación de reserva</span></div></div>
          <span class="ok line">Reserva confirmada</span>
          <dl>
            <dt class="line">Servicio</dt><dd class="line">Traslado privado, aeropuerto a hotel</dd>
            <dt class="line">Fecha</dt><dd class="line">3 de diciembre, vuelo AV254, 3:40 p.m.</dd>
            <dt class="line">Chofer</dt><dd class="line">Miguel, te espera en la salida con tu nombre</dd>
            <dt class="line">Pagado</dt><dd class="line">38 USD, nada más que pagar</dd>
          </dl>
          <p class="foot line">Ejemplo con nombres ficticios. Cancelación gratis hasta 24 horas antes.</p>
        </div>
      </div>
    </section>

    <section class="trustband" id="confianza">
      <div class="wrap">
        <h2>Por qué puedes confiar</h2>
        <p class="sub">No te pedimos que confíes en una promesa. Te damos cosas que puedes comprobar.</p>
        <div class="trust">
          <div><strong>Precio cerrado antes de pagar</strong><span>Ves el total con todo incluido. No hay cargos el día del servicio.</span></div>
          <div><strong>Reembolso completo hasta 24 horas antes</strong><span>Cancelas desde el mismo chat o correo y te devolvemos todo. Si el operador cancela por clima, también.</span></div>
          <div><strong>Operadores con licencia de turismo</strong><span>Empresas registradas en República Dominicana. Si nos lo pides, te decimos cuál presta tu servicio.</span></div>
          <div><strong>Una persona que responde</strong><span>Te atiende Andrés, en español. Si algo sale mal el día del servicio, tienes a quién escribirle.</span></div>
        </div>
      </div>
    </section>

    <section id="quien">
      <div class="wrap">
        <h2>Quién atiende</h2>
        <div class="who">
          <div class="ph">foto<br />próximamente</div>
          <div>
            <p><strong>Andrés</strong>, fundador de {BRAND}. Hispanohablante, como tú. Empecé esto después de ver a demasiados viajeros pagar de más o quedarse esperando en el aeropuerto por no tener a quién preguntarle en su idioma.</p>
            <p>{BRAND} abre reservas para la temporada de diciembre de {year}. Las reseñas de los primeros viajeros aparecerán aquí, con nombre y fecha. No publicamos reseñas inventadas.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="surface" id="preguntas">
      <div class="wrap">
        <h2>Preguntas que nos hacen</h2>
        <p class="sub">Las mismas que se repiten en los grupos de viajeros. Respondidas con datos.</p>
        {FAQ.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="contact" id="contacto">
      <div class="wrap">
        <h2>Asistencia 24/7</h2>
        <p>Antes, durante y después del viaje. Por WhatsApp con el botón verde de abajo, o por correo a <a href={`mailto:${EMAIL}`}>{EMAIL}</a>. Respondemos en menos de 1 hora entre 8 a.m. y 10 p.m., hora de República Dominicana, y a primera hora el resto del día.</p>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap">
      <span>© {year} {BRAND}, Punta Cana, República Dominicana</span>
      <span>Precios en dólares estadounidenses. Servicios prestados por operadores con licencia de turismo.</span>
    </div>
  </footer>

  <div class="support">
    <div class="panel" data-panel role="dialog" aria-label="Asistencia">
      <strong>Asistencia 24/7</strong>
      {supportLink
        ? <p>Escríbenos por WhatsApp y te respondemos en minutos.</p>
        : <p>El WhatsApp se activa en diciembre. Mientras tanto, escríbenos a <a href={`mailto:${EMAIL}`}>{EMAIL}</a> y respondemos en menos de 1 hora.</p>}
      {supportLink && <a class="btn btn-primary btn-sm" href={supportLink} target="_blank" rel="noopener">Abrir WhatsApp</a>}
    </div>
    <button class="bubble" type="button" data-bubble aria-expanded="false">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 12 12 0 0 0 4.6 4c1.7.7 2.3.8 3.1.7a2.7 2.7 0 0 0 1.8-1.3c.2-.6.2-1.2.2-1.3l-.6-.3Z"/></svg>
      Asistencia 24/7
    </button>
  </div>

  <dialog class="checkout" data-checkout data-closed>
    <form class="sheet" method="dialog" data-form novalidate>
      <div class="top">
        <h3 data-title>Reservar</h3>
        <button class="close" type="button" aria-label="Cerrar" data-close>×</button>
      </div>

      <div class="step" data-step="item" data-active>
        <p class="crumb" data-crumb hidden></p>
        <div class="field"><span>Opción</span><div class="opts" data-opts></div></div>
        <label class="field"><span>Fecha del servicio</span><input type="date" name="fecha" required /></label>
        <div class="field"><span>Personas</span>
          <div class="stepper"><button type="button" data-dec aria-label="Menos">−</button><output data-pax>2</output><button type="button" data-inc aria-label="Más">+</button></div>
        </div>
        <label class="check" data-rt hidden><input type="checkbox" name="idaVuelta" /> Ida y vuelta (aeropuerto a hotel y de regreso)</label>
        <p class="err" data-err1>Falta la fecha.</p>
        <div class="total"><span>Este tour<br /><small data-detail></small></span><strong data-itemtotal>0 USD</strong></div>
        <div class="actions"><button class="btn btn-ghost" type="button" data-cancelitem hidden>Atrás</button><button class="btn btn-primary" type="button" data-next>Continuar</button></div>
      </div>

      <div class="step" data-step="cart">
        <ul class="cart" data-cart></ul>
        <div class="addmore" data-addmore>
          <strong data-addtitle>Añade otro tour y ahorra 5 %</strong>
          <div class="chips" data-addbtns></div>
        </div>
        <label class="field"><span>Hotel o zona</span><input type="text" name="hotel" placeholder="Ej. Bahía Príncipe Bávaro" required /></label>
        <p class="err" data-errcart>Falta el hotel.</p>
        <div class="total"><span>Total<br /><small data-discount></small></span><strong data-total>0 USD</strong></div>
        <div class="actions"><button class="btn btn-primary" type="button" data-tocontact>Continuar</button></div>
      </div>

      <div class="step" data-step="contact">
        <label class="field"><span>Tu nombre</span><input type="text" name="nombre" autocomplete="name" required /></label>
        <label class="field"><span>WhatsApp (con código de país)</span><input type="tel" name="whatsapp" autocomplete="tel" placeholder="+57 300 000 0000" required /></label>
        <label class="field"><span>Correo</span><input type="email" name="correo" autocomplete="email" required /></label>
        <p class="err" data-err2>Revisa nombre, WhatsApp y correo.</p>
        <div class="summary" data-summary></div>
        <div class="actions">
          <button class="btn btn-ghost" type="button" data-back>Atrás</button>
          <button class="btn btn-primary" type="button" data-pay>{pending ? 'Confirmar reserva' : 'Pagar con tarjeta'}</button>
        </div>
        <p class="hint">{pending ? 'No se cobra nada ahora. Recibes el enlace de pago seguro en menos de 1 hora y la reserva queda firme cuando pagas.' : 'Pago seguro con tarjeta. La reserva queda firme al pagar.'}</p>
      </div>

      <div class="step done" data-step="done">
        <div class="ok" aria-hidden="true">✓</div>
        <h3>Reserva recibida</h3>
        <p data-donemsg>Te enviamos el enlace de pago y la confirmación en menos de 1 hora.</p>
        <textarea readonly data-copytext aria-label="Resumen de tu reserva"></textarea>
        <div class="actions">
          <button class="btn btn-ghost" type="button" data-copy>Copiar resumen</button>
          <button class="btn btn-primary" type="button" data-close>Listo</button>
        </div>
      </div>
    </form>
  </dialog>

  <script is:inline define:vars={{ catalog, combos, discounts, EMAIL, pending }}>
    // 1. Teléfonos: video solo con wifi (o escritorio sin datos de conexión); con datos móviles, imágenes.
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      var c = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
      var mobile = matchMedia('(max-width: 700px)').matches;
      var wifi;
      if (c && c.type) wifi = c.type === 'wifi' || c.type === 'ethernet';
      else if (c && c.effectiveType) wifi = c.effectiveType === '4g' && !mobile;
      else wifi = !mobile;
      if (c && c.saveData) wifi = false;
      if (reduce || !wifi) return;
      document.querySelectorAll('.screen[data-video]').forEach(function (s) {
        var base = s.getAttribute('data-video'); var v = s.querySelector('video');
        if (!base || !v) return;
        var webm = document.createElement('source'); webm.src = base + '.webm'; webm.type = 'video/webm';
        var mp4 = document.createElement('source'); mp4.src = base + '.mp4'; mp4.type = 'video/mp4';
        v.appendChild(webm); v.appendChild(mp4); v.preload = 'auto';
        v.addEventListener('canplay', function () { v.play().then(function () { v.classList.add('on'); }).catch(function () {}); }, { once: true });
        v.load();
      });
    })();

    // 2. Los teléfonos siguen ligeramente al cursor (solo puntero fino).
    (function () {
      if (!matchMedia('(hover: hover) and (pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var g = document.querySelector('[data-group]'); var hero = document.querySelector('.hero'); if (!g || !hero) return;
      hero.addEventListener('pointermove', function (e) {
        var r = hero.getBoundingClientRect(); var x = (e.clientX - r.left) / r.width - 0.5; var y = (e.clientY - r.top) / r.height - 0.5;
        g.style.transform = 'rotateY(' + (x * 10) + 'deg) rotateX(' + (-y * 6) + 'deg)';
      });
      hero.addEventListener('pointerleave', function () { g.style.transform = ''; });
    })();

    // 3. Revelado al hacer scroll, una sola vez.
    (function () {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.setAttribute('data-visible', ''); io.unobserve(en.target); } });
      }, { rootMargin: '0px 0px -80px 0px' });
      document.querySelectorAll('.reveal, [data-confirm]').forEach(function (el) { io.observe(el); });
    })();

    // 4. Botón de asistencia.
    (function () {
      var b = document.querySelector('[data-bubble]'); var p = document.querySelector('[data-panel]'); if (!b) return;
      setTimeout(function () { b.setAttribute('data-shown', ''); }, 2200);
      b.addEventListener('click', function () {
        var open = p.hasAttribute('data-open');
        p.toggleAttribute('data-open', !open); b.setAttribute('aria-expanded', String(!open));
      });
    })();

    // 5. Flujo de reserva con varios tours y descuento por combo.
    (function () {
      var dlg = document.querySelector('[data-checkout]'); var form = dlg.querySelector('[data-form]');
      var q = function (s) { return dlg.querySelector(s); };
      var state = { pax: 2, items: [], editing: 0, backToCart: false };
      var svc = function (slug) { return catalog.filter(function (s) { return s.slug === slug; })[0]; };
      var opt = function (s, id) { return s.options.filter(function (x) { return x.id === id; })[0] || s.options[0]; };

      function priceOf(it) {
        var s = svc(it.slug); var o = opt(s, it.option); var units, total, detail;
        if (o.unit === 'vehículo') { units = Math.ceil(state.pax / (o.capacity || 4)); total = o.price * units; detail = units + (units === 1 ? ' vehículo' : ' vehículos') + ' de ' + o.price + ' USD'; }
        else { units = state.pax; total = o.price * units; detail = units + (units === 1 ? ' persona' : ' personas') + ' de ' + o.price + ' USD'; }
        if (s.roundTrip && it.rt) { total *= 2; detail += ', ida y vuelta'; }
        return { s: s, o: o, total: total, detail: detail, label: o.label + (s.roundTrip && it.rt ? ', ida y vuelta' : '') };
      }
      var MESES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      function fmtDate(d) { var p = d.split('-'); return p.length === 3 ? parseInt(p[2], 10) + ' ' + MESES[parseInt(p[1], 10) - 1] + ' ' + p[0] : d; }
      function pct(n) { var d = 0; Object.keys(discounts).map(Number).sort().forEach(function (k) { if (n >= k) d = discounts[k]; }); return d; }
      function totals() {
        var sub = 0; state.items.forEach(function (it) { sub += priceOf(it).total; });
        var d = pct(state.items.length); var off = Math.round(sub * d);
        return { sub: sub, d: d, off: off, total: sub - off };
      }
      function goto(n) {
        dlg.querySelectorAll('.step').forEach(function (st) { st.toggleAttribute('data-active', st.getAttribute('data-step') === n); });
        form.scrollTop = 0;
      }
      function renderItem() {
        var it = state.items[state.editing]; var s = svc(it.slug);
        q('[data-title]').textContent = s.name;
        var crumb = q('[data-crumb]'); var n = state.items.length;
        crumb.hidden = n < 2; crumb.textContent = 'Tour ' + (state.editing + 1) + ' de ' + n;
        var opts = q('[data-opts]'); opts.innerHTML = '';
        s.options.forEach(function (o) {
          var l = document.createElement('label'); l.className = 'opt';
          l.innerHTML = '<input type="radio" name="opcion"><span></span><b></b>';
          var inp = l.querySelector('input'); inp.value = o.id; inp.checked = o.id === it.option;
          l.querySelector('span').textContent = o.label; l.querySelector('b').textContent = o.price + ' USD / ' + o.unit;
          inp.addEventListener('change', function () { it.option = o.id; renderTotals(); });
          opts.appendChild(l);
        });
        var f = form.elements.fecha; var t = new Date(); t.setDate(t.getDate() + 1); f.min = t.toISOString().slice(0, 10); f.value = it.date || '';
        var rt = q('[data-rt]'); rt.hidden = !s.roundTrip; rt.querySelector('input').checked = Boolean(it.rt);
        q('[data-cancelitem]').hidden = !state.backToCart;
        q('[data-err1]').removeAttribute('data-show');
        renderTotals(); goto('item');
      }
      function renderTotals() {
        q('[data-pax]').value = state.pax;
        var it = state.items[state.editing]; if (it) { var r = priceOf(it); q('[data-itemtotal]').textContent = r.total + ' USD'; q('[data-detail]').textContent = r.detail; }
      }
      function renderCart() {
        q('[data-title]').textContent = state.items.length > 1 ? 'Tu reserva, ' + state.items.length + ' tours' : 'Tu reserva';
        var ul = q('[data-cart]'); ul.innerHTML = '';
        state.items.forEach(function (it, i) {
          var r = priceOf(it); var li = document.createElement('li');
          li.innerHTML = '<b></b><span class="p"></span><span class="meta"></span><span class="ops"><button type="button" data-edit>Cambiar</button><button type="button" data-remove>Quitar</button></span>';
          li.querySelector('b').textContent = r.s.name; li.querySelector('.p').textContent = r.total + ' USD';
          li.querySelector('.meta').textContent = r.label + ', ' + fmtDate(it.date) + ', ' + state.pax + (state.pax === 1 ? ' persona' : ' personas');
          li.querySelector('[data-edit]').addEventListener('click', function () { state.editing = i; state.backToCart = true; renderItem(); });
          var rm = li.querySelector('[data-remove]'); rm.hidden = state.items.length < 2;
          rm.addEventListener('click', function () { state.items.splice(i, 1); renderCart(); });
          ul.appendChild(li);
        });
        var missing = catalog.filter(function (s) { return !state.items.some(function (it) { return it.slug === s.slug; }); });
        var box = q('[data-addmore]'); box.hidden = missing.length === 0;
        var next = pct(state.items.length + 1); var cur = pct(state.items.length);
        q('[data-addtitle]').textContent = next > cur ? 'Añade otro tour y el descuento sube a ' + Math.round(next * 100) + ' %' : 'Añade otro tour a la misma reserva';
        var chips = q('[data-addbtns]'); chips.innerHTML = '';
        missing.forEach(function (s) {
          var b = document.createElement('button'); b.type = 'button'; b.className = 'chip'; b.textContent = '+ ' + s.name;
          b.addEventListener('click', function () { state.items.push({ slug: s.slug, option: s.options[0].id, date: '', rt: false }); state.editing = state.items.length - 1; state.backToCart = true; renderItem(); });
          chips.appendChild(b);
        });
        var t = totals(); q('[data-total]').textContent = t.total + ' USD';
        var disc = q('[data-discount]'); disc.innerHTML = '';
        if (t.off) { var sp = document.createElement('span'); sp.className = 'off'; sp.textContent = state.items.length + ' tours: ' + Math.round(t.d * 100) + ' % de descuento, −' + t.off + ' USD'; disc.appendChild(sp); }
        else if (state.items.length === 1) disc.textContent = 'Un tour. Con dos, 5 % de descuento.';
        q('[data-errcart]').removeAttribute('data-show');
        goto('cart');
      }
      function openWith(items) {
        if (!items.length) return;
        state.items = items; state.editing = 0; state.backToCart = false; state.pax = 2;
        form.elements.hotel.value = ''; q('[data-err2]').removeAttribute('data-show'); q('[data-copy]').textContent = 'Copiar resumen';
        renderItem();
        dlg.showModal(); requestAnimationFrame(function () { requestAnimationFrame(function () { dlg.removeAttribute('data-closed'); }); });
      }
      function close() {
        dlg.setAttribute('data-closed', '');
        var done = false; var end = function () { if (!done) { done = true; dlg.close(); } };
        q('.sheet').addEventListener('transitionend', end, { once: true }); setTimeout(end, 550);
      }
      function summaryLines() {
        var e = form.elements; var t = totals(); var lines = [];
        state.items.forEach(function (it) { var r = priceOf(it); lines.push([r.s.name, r.label + ', ' + fmtDate(it.date) + ', ' + r.total + ' USD']); });
        lines.push(['Personas', String(state.pax)]); lines.push(['Hotel', e.hotel.value]);
        if (t.off) lines.push(['Descuento combo', Math.round(t.d * 100) + ' %, −' + t.off + ' USD']);
        lines.push(['Total', t.total + ' USD']);
        return lines;
      }
      function summaryText() {
        var e = form.elements;
        return ['Reserva iTravelow'].concat(summaryLines().map(function (p) { return p[0] + ': ' + p[1]; }))
          .concat(['Nombre: ' + e.nombre.value, 'WhatsApp: ' + e.whatsapp.value, 'Correo: ' + e.correo.value]).join('\n');
      }
      function openService(slug) { var s = svc(slug); if (s) openWith([{ slug: s.slug, option: s.options[0].id, date: '', rt: false }]); }
      function openCombo(slug) {
        var c = combos.filter(function (x) { return x.slug === slug; })[0]; if (!c) return;
        openWith(c.items.map(function (i) { return { slug: i.service, option: i.option, date: '', rt: Boolean(i.roundTrip) }; }));
      }
      document.querySelectorAll('[data-reserve]').forEach(function (b) { b.addEventListener('click', function () { openService(b.getAttribute('data-reserve')); }); });
      document.querySelectorAll('[data-combo]').forEach(function (b) { b.addEventListener('click', function () { openCombo(b.getAttribute('data-combo')); }); });
      if (location.hash.indexOf('#reservar-combo-') === 0) openCombo(location.hash.slice(16));
      else if (location.hash.indexOf('#reservar-') === 0) openService(location.hash.slice(10));
      dlg.querySelectorAll('[data-close]').forEach(function (b) { b.addEventListener('click', close); });
      dlg.addEventListener('cancel', function (e) { e.preventDefault(); close(); });
      dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); });
      q('[data-dec]').addEventListener('click', function () { if (state.pax > 1) { state.pax--; renderTotals(); } });
      q('[data-inc]').addEventListener('click', function () { if (state.pax < 20) { state.pax++; renderTotals(); } });
      q('[data-rt] input').addEventListener('change', function (e) { state.items[state.editing].rt = e.target.checked; renderTotals(); });
      q('[data-cancelitem]').addEventListener('click', function () { var it = state.items[state.editing]; if (!it.date) state.items.splice(state.editing, 1); state.backToCart = false; renderCart(); });
      q('[data-next]').addEventListener('click', function () {
        var it = state.items[state.editing]; var ok = Boolean(form.elements.fecha.value);
        q('[data-err1]').toggleAttribute('data-show', !ok); if (!ok) return;
        it.date = form.elements.fecha.value;
        if (state.backToCart) { state.backToCart = false; renderCart(); return; }
        var nxt = -1; state.items.forEach(function (x, i) { if (nxt < 0 && !x.date) nxt = i; });
        if (nxt >= 0) { state.editing = nxt; renderItem(); } else renderCart();
      });
      q('[data-tocontact]').addEventListener('click', function () {
        var ok = form.elements.hotel.value.trim().length > 1; q('[data-errcart]').toggleAttribute('data-show', !ok); if (!ok) return;
        var sum = q('[data-summary]'); sum.innerHTML = '';
        summaryLines().forEach(function (p) { var d = document.createElement('div'); d.innerHTML = '<span></span><span></span>'; d.children[0].textContent = p[0]; d.children[1].textContent = p[1]; sum.appendChild(d); });
        goto('contact');
      });
      q('[data-back]').addEventListener('click', function () { renderCart(); });
      q('[data-pay]').addEventListener('click', function () {
        var e = form.elements; var ok = e.nombre.value.trim().length > 1 && e.whatsapp.value.replace(/\D/g, '').length >= 8 && /.+@.+\..+/.test(e.correo.value);
        q('[data-err2]').toggleAttribute('data-show', !ok); if (!ok) return;
        var text = summaryText(); q('[data-copytext]').value = text;
        try { localStorage.setItem('itravelow_reserva', text); } catch (err) {}
        if (pending) {
          q('[data-donemsg]').textContent = 'Si se abrió tu correo, solo envíalo. Si no, copia este resumen y mándalo a ' + EMAIL + '. Recibes el enlace de pago en menos de 1 hora.';
          var subj = state.items.map(function (it) { return svc(it.slug).name; }).join(' + ');
          window.location.href = 'mailto:' + EMAIL + '?subject=' + encodeURIComponent('Reserva: ' + subj) + '&body=' + encodeURIComponent(text);
        }
        goto('done');
      });
      q('[data-copy]').addEventListener('click', function () {
        var ta = q('[data-copytext]'); ta.select();
        var ok = function () { q('[data-copy]').textContent = 'Copiado'; };
        if (navigator.clipboard) navigator.clipboard.writeText(ta.value).then(ok, function () { document.execCommand('copy'); ok(); });
        else { document.execCommand('copy'); ok(); }
      });
    })();
  </script>
</body>
</html>
